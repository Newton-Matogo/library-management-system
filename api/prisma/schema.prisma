
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATRON
  LIBRARIAN
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Genre {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  books       Book[]
  createdAt   DateTime @default(now())
}

model Book {
  id            String   @id @default(cuid())
  title         String   @unique
  author        String
  isbn          String?  @unique
  publishedYear Int?
  genreId       String
  genre         Genre    @relation(fields: [genreId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
